          "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
           "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
           RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"ndsol", "=", 
          RowBox[{"SolveShapeEqs", "[", 
           RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"(*", 
           RowBox[{
           "Calculate", " ", "bending", " ", "energy", " ", "in", " ", 
            "units", " ", "of", " ", 
            StyleBox[
             SubscriptBox["k", "B"],
             FontSlant->"Italic"], 
            RowBox[{
             StyleBox["T",
              FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"rff", "[", "s_", "]"}], "=", 
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"en", "=", 
            RowBox[{"Kb", " ", "\[Pi]", " ", 
             RowBox[{"rff", "[", "s", "]"}], 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
                  FractionBox[
                   RowBox[{"Sin", "[", 
                    RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                   RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
               RowBox[{
                FractionBox["2", 
                 SuperscriptBox["\[Lambda]B", "2"]], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
              ")"}]}]}], ";", " ", "\[IndentingNewLine]", 
           RowBox[{"Gm", "=", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{"en", ",", 
              RowBox[{"{", 
