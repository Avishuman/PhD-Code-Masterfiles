          "To", " ", "check", " ", "that", " ", "we", " ", "indeed", " ", 
           "have", " ", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", 
            RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
          "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
          RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
          RowBox[{"sMaxs", ",", "p\[Psi]fBs"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "bending", " ", "energy", " ", "in", " ", "units", 
          " ", "of", " ", 
          StyleBox[
           SubscriptBox["k", "B"],
           FontSlant->"Italic"], 
          RowBox[{
           StyleBox["T",
            FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"enBend", "=", 
           RowBox[{"Kb", " ", "\[Pi]", " ", 
            RowBox[{"rff", "[", "s", "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
               FractionBox[
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"enTension", "=", 
           RowBox[{"2", "\[Pi]", " ", "\[Gamma]", " ", 
            RowBox[{"rff", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"GmBend", "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{"enBend", ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "s0B", ",", "sMaxs"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"GmTension", "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{"enTension", ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "s0B", ",", "sMaxs"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Sow", "[", 
           RowBox[{"{", 
            RowBox[{"\[Gamma]", ",", "GmBend", ",", "GmTension"}], "}"}], 
           "]"}], ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"gm", "=", 
         RowBox[{"Kb", " ", "\[Pi]", " ", 
          RowBox[{"rff", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
               FractionBox[
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
            RowBox[{
             FractionBox["2", 
              SuperscriptBox["\[Lambda]B", "2"]], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Gm", "=", 
         RowBox[{"NIntegrate", "[", 
