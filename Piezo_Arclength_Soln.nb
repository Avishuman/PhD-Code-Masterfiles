Cell[CellGroupData[{

Cell["Deformation profiles", "Subsubsection",
 CellChangeTimes->{{3.953914167495577*^9, 
  3.953914170620329*^9}},ExpressionUUID->"08f1ddca-1834-2d41-8bf6-\
cfcfb4a67848"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rdome", "=", "41.82077878168754"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ap", "=", "450"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     RowBox[{"Ap", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]", "*", 
        RowBox[{"Rdome", "^", "2"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Kb", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.0001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lc", "=", 
    RowBox[{"Rdome", "*", 
     RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sMax", "=", 
     RowBox[{"40", "/", "Lc"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
