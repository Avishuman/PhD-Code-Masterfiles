Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rdome", "=", "41.82077878168754"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ap", "=", "450"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     RowBox[{"Ap", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]", "*", 
