       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
          FractionBox[
           RowBox[{"Sin", "[", 
            RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
           RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
       RowBox[{
        FractionBox["2", 
         SuperscriptBox["\[Lambda]B", "2"]], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], ")"}]}]}],
    ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gm", "=", 
