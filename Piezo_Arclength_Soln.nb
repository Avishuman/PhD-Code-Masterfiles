 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]", "=", "0.0001"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "zigzagPairs", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "%50"}], "==", "0"}], ",", 
          RowBox[{"Print", "[", "i", "]"}], ",", "0"}], "]"}], ";", " ", 
        RowBox[{"(*", 
         RowBox[{"Progress", " ", "Checker"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]1", "=", "\[Gamma]"}], ";", 
        RowBox[{"(*", 
         RowBox[{"Older", " ", "\[Gamma]"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Extract", " ", "the", " ", "\[Gamma]", " ", "and", " ", 
          SubscriptBox["R", "P"], " ", "values", " ", "from", " ", "the", " ",
           "sorted", " ", "list", " ", "of", " ", "tuples"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Rdome", ",", "\[Gamma]"}], "}"}], "=", 
         RowBox[{"zigzagPairs", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"RdomeB", "=", 
           RowBox[{"Rdome", "/", "Lc"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"sMax", "=", 
           RowBox[{"5", "*", "\[Lambda]B"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Lambda]", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Kb", "/", "\[Gamma]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Lc", "=", "\[Lambda]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"RdomeB", "=", 
         RowBox[{"Rdome", "/", "Lc"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Lambda]B", "=", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"Kb", "/", "\[Gamma]"}], "]"}], "/", "Lc"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]B", "=", 
         RowBox[{"ArcCos", "[", 
          RowBox[{"1", "-", 
           FractionBox["Scap", 
            RowBox[{"2", "\[Pi]", "*", 
             SuperscriptBox["Rdome", "2"]}]]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sMax", "=", 
         RowBox[{"5", "*", "\[Lambda]B"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Adjust", " ", "the", " ", "dimensionless", " ", "shooting", " ", 
           "variables", " ", "so", " ", "as", " ", "to", " ", "satisfy", " ", 
           "boundary", " ", "conditions", " ", "on", " ", 
           RowBox[{"\[Psi]", "[", "s", "]"}], " ", "and", " ", 
           RowBox[{"pr", "[", "s", "]"}], " ", "at", " ", "s"}], " ", "=", 
          " ", 
          RowBox[{"sb", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"sols", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"shoot", "[", 
             RowBox[{"sMax", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}], "\[Equal]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"prfBi", ",", "prfBs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Use", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
          "shooting", " ", "variables", " ", "determined", " ", "in", " ", 
          "one", " ", "interation", " ", "as", " ", "initial", " ", "guesses",
           " ", "for", " ", "next", " ", 
          RowBox[{"iteration", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"p\[Psi]fBs", "=", 
         RowBox[{"(", 
          RowBox[{"p\[Psi]fBi", "/.", "sols"}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"prfBs", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"prfBi", "/.", "sols"}], ")"}], "*", 
          FractionBox["Lc", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Kb", "/", "\[Gamma]1"}], "]"}]]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"dummy", "=", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"shoot", "[", 
             RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}], 
            "]"}]}], ";", " ", 
          RowBox[{"Print", "[", "dummy", "]"}], ";"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "To", " ", "check", " ", "that", " ", "we", " ", "indeed", " ", 
            "have", " ", 
            RowBox[{"\[Psi]fB", "[", "sB", "]"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"0", " ", "and", " ", 
             RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
            RowBox[{
             RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
          "*)"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
          "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
          RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
