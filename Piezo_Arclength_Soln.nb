 RowBox[{
  RowBox[{"Timing", "[", 
   RowBox[{
    RowBox[{"data0", "=", 
     RowBox[{"Reap", "[", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"Scap", "=", "450"}], ",", 
        RowBox[{"Scap", ">=", "390"}], ",", 
        RowBox[{"Scap", "=", 
         RowBox[{"Scap", "-", "1"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Adjust", " ", "the", " ", "dimensionless", " ", "shooting", " ", 
           "variables", " ", "so", " ", "as", " ", "to", " ", "satisfy", " ", 
           "boundary", " ", "conditions", " ", "on", " ", 
           RowBox[{"\[Psi]", "[", "s", "]"}], " ", "and", " ", 
           RowBox[{"pr", "[", "s", "]"}], " ", "at", " ", "s"}], " ", "=", 
          " ", 
          RowBox[{"sb", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Alpha]B", "=", 
          RowBox[{"ArcCos", "[", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", "Scap", ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "*", "\[Pi]", " ", "*", 
               SuperscriptBox["Rdome", "2"]}], ")"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sols", "=", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"shoot", "[", 
              RowBox[{"sMax", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}], "\[Equal]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"prfBi", ",", "prfBs"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Use", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
           "shooting", " ", "variables", " ", "determined", " ", "in", " ", 
           "one", " ", "interation", " ", "as", " ", "initial", " ", 
           "guesses", " ", "for", " ", "next", " ", 
           RowBox[{"iteration", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"p\[Psi]fBs", "=", 
          RowBox[{"p\[Psi]fBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"prfBs", "=", 
