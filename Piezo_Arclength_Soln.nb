Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ap", "=", "450"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kb", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rdome", "=", "41.82077878168754"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     RowBox[{"Ap", "/", 
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]", "*", 
        SuperscriptBox["Rdome", "2"]}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lc", "=", 
   RowBox[{"Rdome", "*", 
    RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Kb", "/", "\[Gamma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]B", "=", 
   RowBox[{"\[Lambda]", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RdomeB", "=", 
   RowBox[{"Rdome", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rb", "=", "32"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rbB", "=", 
   RowBox[{"rb", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hdimple", "=", "0.24"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hrim", "=", 
   RowBox[{"-", "0.52"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "=", 
    RowBox[{"N", "[", 
     RowBox[{"ArcSin", "[", 
      RowBox[{"Hrim", "*", "0.001", "*", "rb"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rdome", "=", 
     RowBox[{"42", "nm"}]}], ",", " ", 
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"0.5", " ", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "/", 
       SuperscriptBox["nm", "2"]}]}]}], ",", " ", 
    RowBox[{"Lc", "=", 
     RowBox[{"Rdome", "*", 
      RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], ",", " ", 
    RowBox[{"sb", "=", 
     RowBox[{"20", "nm"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p\[Psi]fBs", "=", 
    RowBox[{"-", "0.2023901635283968`"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rdome", "=", 
     RowBox[{"42", "nm"}]}], ",", " ", 
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"0.0001", " ", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "/", 
       SuperscriptBox["nm", "2"]}]}]}], ",", " ", 
    RowBox[{"\[Beta]", "=", "0"}], ",", " ", 
    RowBox[{"rb", "=", 
     RowBox[{"32", "nm"}]}], ",", " ", 
    RowBox[{"Lc", "=", 
     RowBox[{"Rdome", "*", 
      RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sMaxs", "=", "\[InvisibleSpace]", 
   RowBox[{"20", 
    RowBox[{"(*", "nm", "*)"}], "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sols", "=", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"shoot", "[", 
        RowBox[{"sMaxB", ",", "p\[Psi]fBii"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", "rbB"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"sMaxB", ",", "sMaxs"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p\[Psi]fBii", ",", "p\[Psi]fBs"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sbSolved", "=", " ", 
   RowBox[{"sMaxB", " ", "/.", "sols"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p\[Psi]fBs0", "=", 
