     RowBox[{"\[Psi]fB", "[", "sb", "]"}], "=", "0"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p\[Psi]fBs", "=", 
    RowBox[{"-", "1.11485"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Timing", "[", 
   RowBox[{
    RowBox[{"data0", "=", 
     RowBox[{"Reap", "[", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"\[Gamma]", "=", 
         RowBox[{"(*", "0.01", "*)"}], "0.0001"}], ",", 
        RowBox[{"(*", 
         RowBox[{"\[Gamma]", "\[GreaterEqual]", "0.00009"}], "*)"}], 
        RowBox[{"\[Gamma]", "\[LessEqual]", "1.1"}], ",", 
        RowBox[{"\[Gamma]", "=", 
         RowBox[{"(*", 
          RowBox[{"\[Gamma]", "-", "0.0001"}], "*)"}], 
         RowBox[{"\[Gamma]", "+", "0.0005"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Adjust", " ", "the", " ", "dimensionless", " ", "shooting", " ", 
           "variables", " ", "so", " ", "as", " ", "to", " ", "satisfy", " ", 
           "boundary", " ", "conditions", " ", "on", " ", 
           RowBox[{"\[Psi]", "[", "s", "]"}], " ", "and", " ", 
           RowBox[{"pr", "[", "s", "]"}], " ", "at", " ", "s"}], " ", "=", 
          " ", 
          RowBox[{"sb", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"sols", "=", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"shoot", "[", 
              RowBox[{"sMax", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}], "\[Equal]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"prfBi", ",", "prfBs"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Use", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
           "shooting", " ", "variables", " ", "determined", " ", "in", " ", 
           "one", " ", "interation", " ", "as", " ", "initial", " ", 
           "guesses", " ", "for", " ", "next", " ", 
           RowBox[{"iteration", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"p\[Psi]fBs", "=", 
          RowBox[{"p\[Psi]fBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"prfBs", "=", 
          RowBox[{"prfBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"dummy", "=", 
            RowBox[{"Evaluate", "[", 
             RowBox[{"shoot", "[", 
              RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Print", "[", "dummy", "]"}], ";"}], "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "To", " ", "check", " ", "that", " ", "we", " ", "indeed", " ", 
             "have", " ", 
             RowBox[{"\[Psi]fB", "[", "sB", "]"}]}], " ", "=", " ", 
            RowBox[{
             RowBox[{"0", " ", "and", " ", 
              RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
             RowBox[{
              RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
           "*)"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
           "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
           RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"ndsol", "=", 
          RowBox[{"SolveShapeEqs", "[", 
           RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"(*", 
           RowBox[{
           "Calculate", " ", "bending", " ", "energy", " ", "in", " ", 
            "units", " ", "of", " ", 
            StyleBox[
             SubscriptBox["k", "B"],
             FontSlant->"Italic"], 
            RowBox[{
             StyleBox["T",
              FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"rff", "[", "s_", "]"}], "=", 
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"en", "=", 
            RowBox[{"Kb", " ", "\[Pi]", " ", 
             RowBox[{"rff", "[", "s", "]"}], 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
                  FractionBox[
                   RowBox[{"Sin", "[", 
                    RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                   RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
               RowBox[{
                FractionBox["2", 
                 SuperscriptBox["\[Lambda]B", "2"]], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
              ")"}]}]}], ";", " ", "\[IndentingNewLine]", 
           RowBox[{"G", "=", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{"en", ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "s0B", ",", "sMax"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Sow", "[", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]", ",", "G"}], "}"}], "]"}], " ", 
           RowBox[{"(*", 
            RowBox[{"Export", " ", "data"}], "*)"}], ";"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Sow", "[", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]", ",", 
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{
               RowBox[{"rfB", "[", "sMax", "]"}], "/.", "ndsol"}], "]"}], "*",
              "Lc"}]}], "}"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "\[Gamma]", "]"}]}]}], "\[IndentingNewLine]", 
       "]"}], "]"}]}], ";"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
    RowBox[{"data0", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
