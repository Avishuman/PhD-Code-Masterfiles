Cell[TextData[{
 "Now we use this data to construct the interpolating function G(Rp, gamma). \
This\[CloseCurlyQuote]ll allow us to construct the energy for Piezo\
\[CloseCurlyQuote]s closed conformation.\nAnother task is to solve the HCE \
for a flat dome, which corresponds to the open conformation. In such a limit, \
the initial conditions change to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"rfB", "(", "s0B", ")"}], "=", 
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["A", "P"], "/", "\[Pi]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"4deb8c8a-4b5c-1141-acfe-abb5e5c008d6"],
 ","
}], "Text",
 CellChangeTimes->{{3.942156200474121*^9, 3.942156273720928*^9}, {
   3.9421683515886345`*^9, 3.942168351733572*^9}, {3.942169038820513*^9, 
   3.9421690621395855`*^9}, {3.942169113054287*^9, 3.9421693038402023`*^9}, 
   3.9422601082910633`*^9},ExpressionUUID->"65ed3b1b-931e-9c4a-a06a-\
1d2a9c3a1e0c"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.942168364462763*^9, 3.9421683672649193`*^9}, {
  3.9421684554198265`*^9, 
  3.942168456315687*^9}},ExpressionUUID->"d57bdacb-3fb2-9a40-8a90-\
a72c759906c8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "M"], TraditionalForm]],ExpressionUUID->
  "a3e7dee3-8d6f-dd4e-8517-9d171ee6151c"],
 " vs \[Gamma] in open configuration"
}], "Subsection",
 CellChangeTimes->{{3.9422469510047817`*^9, 3.9422469596521626`*^9}, {
  3.9422473017619705`*^9, 
  3.942247321056967*^9}},ExpressionUUID->"37221715-4966-a149-87a7-\
513c56ff0889"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s0B", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SolveShapeEqs", "[", 
    RowBox[{"sbB_", ",", "p\[Psi]fBi_", ",", "prfBi_"}], "]"}], ":=", 
   RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Psi]fB", "\[Prime]",
          MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           RowBox[{"rfB", "[", "sB", "]"}]}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p\[Psi]fB", "[", "sB", "]"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["rfB", "\[Prime]",
          MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["hfB", "\[Prime]",
          MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["p\[Psi]fB", "\[Prime]",
          MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"p\[Psi]fB", "[", "sB", "]"}], 
             RowBox[{"rfB", "[", "sB", "]"}]], "-", " ", 
            RowBox[{"phfB", "[", "sB", "]"}]}], ")"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            FractionBox[
