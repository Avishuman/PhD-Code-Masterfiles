Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Solution", " ", "of", " ", "the", " ", "Hamilton", " ", "equations", " ", 
    "in", " ", "dimensionless", " ", "form", " ", "as", " ", "a", " ", 
    "function", " ", "of", " ", "sbB", " ", "and", " ", "the", " ", 
    "shooting", " ", 
    RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s0B", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SolveShapeEqs", "[", 
      RowBox[{"sbB_", ",", "p\[Psi]fBi_", ",", "prfBi_"}], "]"}], ":=", 
     RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Psi]fB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"2", " ", 
             RowBox[{"rfB", "[", "sB", "]"}]}]], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p\[Psi]fB", "[", "sB", "]"}], "-", 
             RowBox[{"2", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["rfB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["hfB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["p\[Psi]fB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"p\[Psi]fB", "[", "sB", "]"}], 
               RowBox[{"rfB", "[", "sB", "]"}]], "-", " ", 
              RowBox[{"phfB", "[", "sB", "]"}]}], ")"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"2", " ", 
                RowBox[{"rfB", "[", "sB", "]"}]}], 
               SuperscriptBox["\[Lambda]B", "2"]], "+", 
              RowBox[{"prfB", "[", "sB", "]"}]}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["prfB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{"p\[Psi]fB", "[", "sB", "]"}], 
             RowBox[{"4", " ", 
              SuperscriptBox[
               RowBox[{"rfB", "[", "sB", "]"}], "2"]}]], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"p\[Psi]fB", "[", "sB", "]"}], "-", 
              RowBox[{"4", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}], ")"}]}], "+", 
           RowBox[{
            FractionBox["2", 
             SuperscriptBox["\[Lambda]B", "2"]], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["phfB", "\[Prime]",
            MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", "0"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Initial", " ", 
           RowBox[{"conditions", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Psi]fB", "[", "s0B", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rfB", "[", "s0B", "]"}], "\[Equal]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               FractionBox["Scap", "\[Pi]"], "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 FractionBox["Scap", 
                  RowBox[{"4", "\[Pi]", "*", 
                   SuperscriptBox["Rdome", "2"]}]]}], ")"}]}], "]"}], "/", 
             "Lc"}], ","}], "*)"}], 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            FractionBox["Scap", "\[Pi]"], "]"}], "/", "Lc"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"hfB", "[", "s0B", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p\[Psi]fB", "[", "s0B", "]"}], "\[Equal]", "p\[Psi]fBi"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"prfB", "[", "s0B", "]"}], "\[Equal]", "prfBi"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"phfB", "[", "s0B", "]"}], "\[Equal]", "0"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\[Psi]fB", ",", "rfB", ",", "hfB", ",", "p\[Psi]fB", ",", "prfB", ",",
          "phfB"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sB", ",", "s0B", ",", "sbB"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<ImplicitRungeKutta\>\""}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9499569956767597`*^9, 3.949957016836937*^9}, {
   3.949978990528303*^9, 3.949979018505867*^9}, 3.9499791761856403`*^9, 
