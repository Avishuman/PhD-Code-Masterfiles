       RowBox[{"SolveShapeEqs", "[", 
        RowBox[{"sbB", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Use", " ", 
      RowBox[{"here", " ", "?", "NumberQ"}], " ", "to", " ", "indicate", " ", 
      "that", " ", "sbB"}], ",", " ", "p\[Psi]fB0", ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "prfB0", " ", "are", " ", "numbers"}], ";", " ", 
