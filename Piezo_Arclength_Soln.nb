      RowBox[{"prfB", "[", "sB", "]"}], " ", "at", " ", "s"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"sbB", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "these", " ", "are", " ", "the", " ", "boundary", " ", "values", " ",
           "used", " ", "to", " ", "satisfy", " ", "the", " ", "boundary", " ",
           "conditions", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}], 
        ")"}]}], ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"shoot", "[", 
      RowBox[{
       RowBox[{"sbB_", "?", "NumberQ"}], ",", 
