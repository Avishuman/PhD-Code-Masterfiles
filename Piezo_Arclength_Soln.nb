Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"R0", "=", "41.82077878168754"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rdome", "=", "57"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Scap", "=", "450"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"N", "[", 
    RowBox[{"ArcCos", "[", 
     RowBox[{"1", "-", 
      RowBox[{"Scap", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "\[Pi]", "*", 
         RowBox[{"Rdome", "^", "2"}]}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kb", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kp", "=", "17.528030182689953"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lc", "=", 
   RowBox[{"Rdome", " ", 
    RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Kb", "/", "\[Gamma]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]B", "=", 
   RowBox[{"\[Lambda]", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RdomeB", "=", 
   RowBox[{"Rdome", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sMaxB", "=", 
   RowBox[{"5", "\[Lambda]B"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "=", "0"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prfBs", "=", 
    RowBox[{
     RowBox[{"-", "0.013862379662330653"}], "*", 
     RowBox[{"Lc", "/", 
      RowBox[{"N", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Kb", "/", "0.0001"}], "]"}], "]"}]}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"At", " ", "Rdome"}], "=", 
     RowBox[{"42", "nm"}]}], ",", 
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"0.0001", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "/", 
       SuperscriptBox["nm", "2"]}]}]}], ",", 
    RowBox[{"Scap", "=", "450"}], ",", 
    RowBox[{"Lc", "=", "\[Lambda]"}], ",", 
    RowBox[{"sb", "=", 
     RowBox[{"5", "\[Lambda]B"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p\[Psi]fBs", "=", 
   RowBox[{"-", "0.0014491702075504717"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"data0", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"\[Gamma]", "=", 
        RowBox[{"(*", "0.01", "*)"}], "0.0001"}], ",", 
       RowBox[{"(*", 
        RowBox[{"\[Gamma]", "\[GreaterEqual]", "0.00009"}], "*)"}], 
       RowBox[{"\[Gamma]", "<=", "1.1"}], 
       RowBox[{"(*", "0.50001", "*)"}], ",", 
       RowBox[{"\[Gamma]", "=", 
        RowBox[{"(*", 
         RowBox[{"\[Gamma]", "-", "0.0001"}], "*)"}], 
        RowBox[{"\[Gamma]", "+", "0.005"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Lambda]", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Kb", "/", "\[Gamma]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Lambda]B", "=", 
         RowBox[{"\[Lambda]", "/", "Lc"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sMaxB", "=", 
         RowBox[{"5", "\[Lambda]B"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"shoot", "[", 
             RowBox[{"sMaxB", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"\[Beta]", ",", "0"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"prfBi", ",", "prfBs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p\[Psi]fBs", "=", 
         RowBox[{"p\[Psi]fBi", "/.", "ndsol"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prfBs", "=", 
         RowBox[{"prfBi", "/.", "ndsol"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dummy", "=", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"shoot", "[", 
           RowBox[{"sMaxB", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}], "]"}]}],
         ";", " ", 
        RowBox[{"Print", "[", 
         RowBox[{"\[Gamma]", ",", "\"\< \>\"", ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"dummy", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "*", 
            RowBox[{"180", "/", "\[Pi]"}]}], "]"}], ",", "\"\< \>\"", ",", 
          " ", 
          RowBox[{"dummy", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
          RowBox[{"sMaxB", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rff", "[", "s_", "]"}], ":=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"rfB", "[", "s", "]"}], "/.", "sol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"hff", "[", "s_", "]"}], ":=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"hfB", "[", "s", "]"}], "/.", "sol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]ff", "[", "s_", "]"}], ":=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "sol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gm", "=", 
         RowBox[{"Kb", " ", "\[Pi]", " ", 
          RowBox[{"rff", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
               FractionBox[
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
            RowBox[{
             FractionBox["2", 
              SuperscriptBox["\[Lambda]B", "2"]], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Gm", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{"gm", ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", "sMaxB"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", "Gm"}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
