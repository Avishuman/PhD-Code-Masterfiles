 RowBox[{
  RowBox[{
   RowBox[{"Rdome", "=", "41.82077878168754"}], ";"}], 
  RowBox[{"(*", "nm", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ap", "=", "450"}], ";"}], 
  RowBox[{"(*", 
   SuperscriptBox["nm", "2"], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     RowBox[{"Ap", "/", 
