Cell[CellGroupData[{

Cell["Hamilton equations in zero tension limit", "Subsubsection",
 CellChangeTimes->{{3.959767801877716*^9, 3.9597678493009777`*^9}, {
  3.9597681049544926`*^9, 3.9597681154352055`*^9}, {3.9600446686411247`*^9, 
  3.9600446748751526`*^9}},ExpressionUUID->"25068578-ed91-fb49-a70c-\
47af228cf571"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s0B", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SolveShapeEqs", "[", 
     RowBox[{"sbB_", ",", "p\[Psi]fBi_", ",", "prfBi_"}], "]"}], ":=", 
    RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Psi]fB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", 
            RowBox[{"rfB", "[", "sB", "]"}]}]], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p\[Psi]fB", "[", "sB", "]"}], "-", 
            RowBox[{"2", " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["rfB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["hfB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["p\[Psi]fB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"p\[Psi]fB", "[", "sB", "]"}], 
              RowBox[{"rfB", "[", "sB", "]"}]], "-", " ", 
             RowBox[{"phfB", "[", "sB", "]"}]}], ")"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"prfB", "[", "sB", "]"}], "*", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["prfB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", 
         RowBox[{
          FractionBox[
           RowBox[{"p\[Psi]fB", "[", "sB", "]"}], 
           RowBox[{"4", " ", 
            SuperscriptBox[
             RowBox[{"rfB", "[", "sB", "]"}], "2"]}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p\[Psi]fB", "[", "sB", "]"}], "-", 
            RowBox[{"4", " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Psi]fB", "[", "sB", "]"}], "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["phfB", "\[Prime]",
           MultilineFunction->None], "[", "sB", "]"}], "\[Equal]", "0"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Initial", " ", 
          RowBox[{"conditions", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]fB", "[", "s0B", "]"}], "\[Equal]", "\[Alpha]B"}], ",", 
        RowBox[{"(*", 
         RowBox[{"0", ","}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rfB", "[", "s0B", "]"}], "\[Equal]", 
         RowBox[{"RdomeB", " ", 
          RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"Scap", "/", "\[Pi]"}], "]"}], "/", "Lc"}], ","}], "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"hfB", "[", "s0B", "]"}], "\[Equal]", 
         RowBox[{"RdomeB", "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Cos", "[", "\[Alpha]B", "]"}]}], ")"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"0", ","}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"p\[Psi]fB", "[", "s0B", "]"}], "\[Equal]", "p\[Psi]fBi"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"prfB", "[", "s0B", "]"}], "\[Equal]", "prfBi"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"phfB", "[", "s0B", "]"}], "\[Equal]", "0"}]}], 
       "\[IndentingNewLine]", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\[Psi]fB", ",", "rfB", ",", "hfB", ",", "p\[Psi]fB", ",", "prfB", ",",
         "phfB"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"sB", ",", "s0B", ",", "sbB"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Solve", " ", "the", " ", "Hamilton", " ", "equations", " ", "in", " ", 
     "dimensionless", " ", "form", " ", "as", " ", "a", " ", "function", " ", 
     "of", " ", "the", " ", "shooting", " ", "variables"}], ",", " ", 
    RowBox[{
     RowBox[{
     "and", " ", "output", " ", "the", " ", "boundary", " ", "values", " ", 
      "of", " ", 
      RowBox[{"\[Psi]fB", "[", "sB", "]"}], " ", "and", " ", 
      RowBox[{"prfB", "[", "sB", "]"}], " ", "at", " ", "s"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"sbB", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "these", " ", "are", " ", "the", " ", "boundary", " ", "values", " ",
           "used", " ", "to", " ", "satisfy", " ", "the", " ", "boundary", " ",
           "conditions", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}], 
