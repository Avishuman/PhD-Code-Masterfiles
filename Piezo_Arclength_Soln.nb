Cell[TextData[{
 "Here, we\[CloseCurlyQuote]re iterating over different values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "P"], TraditionalForm]],ExpressionUUID->
  "d2ffac0d-b8e0-4e47-b6d7-ab525a99d0b0"],
 ". Therefore, a better choice of length scale for the problem would be the \
decay length \[Lambda]."
}], "Text",
