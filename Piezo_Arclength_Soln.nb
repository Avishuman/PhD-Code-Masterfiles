      RowBox[{"nm", "/", "Lc"}]}]}], ",", " ", 
    RowBox[{"\[Beta]", "=", "0"}], ",", " ", 
    RowBox[{"Scap", "=", "450"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p\[Psi]fBs", "=", 
