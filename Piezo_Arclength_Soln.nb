        RowBox[{"s", ",", "sSamples"}], "}"}]}], "]"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gm", "=", 
    RowBox[{"Kb", " ", "\[Pi]", " ", 
