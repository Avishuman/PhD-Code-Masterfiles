Cell[CellGroupData[{

Cell["\<\
Sweep over rb and calculate footprint energy of hypothetical Piezo-membrane \
system\
\>", "Subsubsection",
 CellChangeTimes->{{3.990112455505432*^9, 3.9901124771660347`*^9}, {
  3.990112681853876*^9, 
  3.9901127007352104`*^9}},ExpressionUUID->"266ef658-1155-9f42-b059-\
40cb2efa724f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ap", "=", "450"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kb", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rdome", "=", "41.82077878168754"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     RowBox[{"Ap", "/", 
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]", "*", 
        SuperscriptBox["Rdome", "2"]}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lc", "=", 
   RowBox[{"Rdome", "*", 
    RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Kb", "/", "\[Gamma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]B", "=", 
   RowBox[{"\[Lambda]", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RdomeB", "=", 
   RowBox[{"Rdome", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Hdimple", "=", "0.24"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"micron", "^", 
    RowBox[{"-", "1"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Hrim", "=", 
    RowBox[{"-", "0.52"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"micron", "^", 
    RowBox[{"-", "1"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p\[Psi]fBs", "=", 
    RowBox[{"-", "0.175012"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rdome", "=", 
     RowBox[{"42", "nm"}]}], ",", " ", 
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"0.0001", " ", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "/", 
       SuperscriptBox["nm", "2"]}]}]}], ",", " ", 
    RowBox[{"\[Beta]", " ", "=", " ", 
     RowBox[{
      SubscriptBox["\[Beta]", "dimple"], " ", "=", " ", 
      RowBox[{"0.00072", " ", "rad"}]}]}], ",", " ", 
    RowBox[{"rb", "=", 
     RowBox[{"32", "nm"}]}], ",", " ", 
    RowBox[{"Lc", "=", 
     RowBox[{"Rdome", "*", 
      RowBox[{"Sin", "[", "\[Alpha]B", "]"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sMaxs", "=", 
   RowBox[{"20.3405", 
    RowBox[{"(*", "nm", "*)"}], "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rb", "=", "30"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"data0", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"rb", "=", "30"}], ",", 
       RowBox[{"rb", "<=", "50"}], ",", 
       RowBox[{"rb", "=", 
        RowBox[{"rb", "+", "0.1"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rbB", "=", 
         RowBox[{"rb", "/", "Lc"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Beta]", "=", 
         RowBox[{"N", "[", 
          RowBox[{"ArcSin", "[", 
           RowBox[{"Hrim", "*", "0.001", "*", "rb"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sols", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"shoot", "[", 
             RowBox[{"sbB", ",", "p\[Psi]fBi"}], "]"}], "\[Equal]", 
            RowBox[{"{", 
             RowBox[{"\[Beta]", ",", "rbB"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"sbB", ",", "sMaxs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Use", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
          "shooting", " ", "variables", " ", "determined", " ", "in", " ", 
          "one", " ", "interation", " ", "as", " ", "initial", " ", "guesses",
           " ", "for", " ", "next", " ", 
          RowBox[{"iteration", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"p\[Psi]fBs", "=", 
         RowBox[{"p\[Psi]fBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sMaxs", "=", 
         RowBox[{"sbB", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"dummy", "=", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"shoot", "[", 
           RowBox[{"sMaxs", ",", "p\[Psi]fBs"}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"Print", "[", 
         RowBox[{"\[Gamma]", ",", "\"\< \>\"", ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"dummy", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "*", 
            RowBox[{"180", "/", "\[Pi]"}]}], "]"}], ",", "\"\< \>\"", ",", 
          " ", 
          RowBox[{
           RowBox[{"dummy", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "*", "Lc"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "To", " ", "check", " ", "that", " ", "we", " ", "indeed", " ", 
           "have", " ", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", 
            RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
          "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
          RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
          RowBox[{"sMaxs", ",", "p\[Psi]fBs"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "footprint", " ", "energy", " ", "in", " ", 
          "units", " ", "of", " ", 
          StyleBox[
           SubscriptBox["k", "B"],
           FontSlant->"Italic"], 
          RowBox[{
           StyleBox["T",
            FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"en", "=", 
         RowBox[{"Kb", " ", "\[Pi]", " ", 
          RowBox[{"rff", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
               FractionBox[
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
            RowBox[{
             FractionBox["2", 
              SuperscriptBox["\[Lambda]B", "2"]], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"G", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{"en", ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "s0B", ",", "sMaxs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"rb", ",", "G"}], "}"}], "]"}], " ", 
        RowBox[{"(*", 
         RowBox[{"Export", " ", "data"}], "*)"}], ";"}]}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "\[Gamma]", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
    RowBox[{"data0", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99011273041041*^9, 3.9901129248089657`*^9}, {
   3.990112957189186*^9, 3.9901131938072968`*^9}, {3.9901132751038933`*^9, 
   3.990113325884079*^9}, {3.990113379314905*^9, 3.9901134154476166`*^9}, 
   3.990113526633871*^9, {3.990114839771801*^9, 3.9901149154722004`*^9}, 
   3.9901214280232334`*^9, {3.9901215094630203`*^9, 3.990121565957899*^9}, {
   3.9901220880828056`*^9, 3.9901221451450653`*^9}, {3.990122231088194*^9, 
   3.990122231864229*^9}, {3.9901223265027657`*^9, 3.9901223287427616`*^9}, 
   3.9901232372625256`*^9, {3.990123298632372*^9, 3.990123300152811*^9}},
 CellLabel->
  "In[223]:=",ExpressionUUID->"e8940d9b-85d0-d04b-9d78-41a82498e987"],

