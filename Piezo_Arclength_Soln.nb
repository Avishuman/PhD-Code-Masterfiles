            RowBox[{"0", " ", "and", " ", 
             RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
            RowBox[{
             RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
          "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
           "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
           RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Closedndsol", "=", 
          RowBox[{"SolveShapeEqs", "[", 
           RowBox[{
           "ClosedsMaxB", ",", "Closedp\[Psi]fBs", ",", "\[Theta]", ",", 
            "r0ClosedB"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Openndsol", "=", 
          RowBox[{"SolveShapeEqs", "[", 
           RowBox[{
           "OpensMaxB", ",", "Openp\[Psi]fBs", ",", "0", ",", "r0OpenB"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Calculate", " ", "bending", " ", "energy", " ", "in", " ", "units",
            " ", "of", " ", 
           StyleBox[
            SubscriptBox["k", "B"],
            FontSlant->"Italic"], 
           RowBox[{
            StyleBox["T",
             FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Closed\[Psi]ff", "[", "s_", "]"}], "=", 
          RowBox[{"First", "[", 
           RowBox[{
            RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "Closedndsol"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Closedrff", "[", "s_", "]"}], "=", 
          RowBox[{"First", "[", 
           RowBox[{
            RowBox[{"rfB", "[", "s", "]"}], "/.", "Closedndsol"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Open\[Psi]ff", "[", "s_", "]"}], "=", 
          RowBox[{"First", "[", 
           RowBox[{
            RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "Openndsol"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Openrff", "[", "s_", "]"}], "=", 
          RowBox[{"First", "[", 
           RowBox[{
            RowBox[{"rfB", "[", "s", "]"}], "/.", "Openndsol"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"gmClosed", "=", 
          RowBox[{"Kb", " ", "\[Pi]", " ", 
           RowBox[{"Closedrff", "[", "s", "]"}], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"Closed\[Psi]ff", "[", "s", "]"}], ",", "s"}], 
                 "]"}], "+", 
                FractionBox[
                 RowBox[{"Sin", "[", 
                  RowBox[{"Closed\[Psi]ff", "[", "s", "]"}], "]"}], 
                 RowBox[{"Closedrff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
             RowBox[{
              FractionBox["2", 
               SuperscriptBox["\[Lambda]B", "2"]], 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Cos", "[", 
                 RowBox[{"Closed\[Psi]ff", "[", "s", "]"}], "]"}]}], 
               ")"}]}]}], ")"}]}]}], ";", " ", "\[IndentingNewLine]", 
         RowBox[{"gmOpen", "=", 
          RowBox[{"Kb", " ", "\[Pi]", " ", 
           RowBox[{"Openrff", "[", "s", "]"}], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"Open\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], 
                "+", 
                FractionBox[
                 RowBox[{"Sin", "[", 
                  RowBox[{"Open\[Psi]ff", "[", "s", "]"}], "]"}], 
                 RowBox[{"Openrff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
             RowBox[{
              FractionBox["2", 
               SuperscriptBox["\[Lambda]B", "2"]], 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Cos", "[", 
                 RowBox[{"Open\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
            ")"}]}]}], ";", " ", "\[IndentingNewLine]", 
         RowBox[{"GmClosed", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{"gmClosed", ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "0", ",", "ClosedsMaxB"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"GmOpen", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{"gmOpen", ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "0", ",", "OpensMaxB"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Sow", "[", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]", ",", "GmClosed", ",", "GmOpen"}], "}"}], "]"}],
          " ", 
         RowBox[{"(*", 
          RowBox[{"Export", " ", "data"}], "*)"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], "]"}], 
