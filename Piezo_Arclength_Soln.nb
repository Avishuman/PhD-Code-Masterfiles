      RowBox[{"\[Beta]", "=", "0"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"p\[Psi]fBs", "=", 
     RowBox[{"-", "1.11485"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prfBs", "=", 
    RowBox[{"-", "0.004281797587261707`"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rdome", "=", 
     RowBox[{"42", "nm"}]}], ",", " ", 
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"1*^-4", " ", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "/", 
       SuperscriptBox["nm", "2"]}]}]}], ",", " ", 
    RowBox[{"Lc", "=", 
     RowBox[{"Rdome", "*", 
      RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], ",", " ", 
    RowBox[{"sb", "=", 
     RowBox[{"40", "nm"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p\[Psi]fBs", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"data0", "=", 
    RowBox[{"Reap", "[", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"\[Beta]", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], "/", "2"}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"\[Gamma]", "\[GreaterEqual]", "0.00009"}], "*)"}], 
       RowBox[{"\[Beta]", "<=", 
        RowBox[{"N", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}], ",", 
       RowBox[{"\[Beta]", "=", 
        RowBox[{"(*", 
         RowBox[{"\[Gamma]", "-", "0.0001"}], "*)"}], 
        RowBox[{"\[Beta]", "+", "0.001"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Adjust", " ", "the", " ", "dimensionless", " ", "shooting", " ", 
          "variables", " ", "so", " ", "as", " ", "to", " ", "satisfy", " ", 
          "boundary", " ", "conditions", " ", "on", " ", 
          RowBox[{"\[Psi]", "[", "s", "]"}], " ", "and", " ", 
          RowBox[{"pr", "[", "s", "]"}], " ", "at", " ", "s"}], " ", "=", " ", 
         RowBox[{"sb", ":"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sols", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"shoot", "[", 
             RowBox[{"sMax", ",", "p\[Psi]fBi", ",", "prfBi"}], "]"}], "\[Equal]", 
            RowBox[{"{", 
             RowBox[{"\[Beta]", ",", "0"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"prfBi", ",", "prfBs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Use", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
          "shooting", " ", "variables", " ", "determined", " ", "in", " ", 
          "one", " ", "interation", " ", "as", " ", "initial", " ", "guesses",
           " ", "for", " ", "next", " ", 
          RowBox[{"iteration", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"p\[Psi]fBs", "=", 
         RowBox[{"p\[Psi]fBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prfBs", "=", 
         RowBox[{"prfBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"dummy", "=", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"shoot", "[", 
           RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}], "]"}]}], 
        ";", " ", 
        RowBox[{"Print", "[", 
         RowBox[{"\[Beta]", ",", "dummy"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "To", " ", "check", " ", "that", " ", "we", " ", "indeed", " ", 
           "have", " ", 
           RowBox[{"\[Psi]fB", "[", "sB", "]"}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", 
            RowBox[{"prfB", "[", "sB", "]"}]}], " ", "=", " ", 
           RowBox[{
            RowBox[{"0", " ", "at", " ", "s"}], " ", "=", " ", "sbB"}]}]}], 
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Assemble", " ", "solution", " ", "using", " ", "the", " ", 
          "correct", " ", "values", " ", "of", " ", "the", " ", "shooting", " ", 
          RowBox[{"variables", ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
          RowBox[{"sMax", ",", "p\[Psi]fBs", ",", "prfBs"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "bending", " ", "energy", " ", "in", " ", "units", 
          " ", "of", " ", 
          StyleBox[
           SubscriptBox["k", "B"],
           FontSlant->"Italic"], 
          RowBox[{
           StyleBox["T",
            FontSlant->"Italic"], ":"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"en", "=", 
         RowBox[{"Kb", " ", "\[Pi]", " ", 
          RowBox[{"rff", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            FractionBox["2", 
             SuperscriptBox["\[Lambda]B", "2"]], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}], 
           ")"}]}]}], ";", " ", "\[IndentingNewLine]", 
        RowBox[{"Gm", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{"en", ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "s0B", ",", "sMax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"\[Beta]", ",", "Gm"}], "}"}], "]"}], " ", 
        RowBox[{"(*", 
         RowBox[{"Export", " ", "data"}], "*)"}], ";"}]}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"rfB", "[", "sMax", "]"}], "/.", "ndsol"}], "]"}], "*", 
            "Lc"}]}], "}"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Print", "[", "\[Beta]", "]"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Sow", "[", 
        RowBox[{"{", 
         RowBox[{"\[Beta]", ",", "p\[Psi]fBs", ",", "prfBs"}], "}"}], "]"}], 
       "*)"}], "\[IndentingNewLine]", "]"}], "]"}]}], ";"}], "]"}]}], "Input",
