Cell[BoxData[{
 RowBox[{
  RowBox[{"Rdome", "=", "10.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Scap", "=", "390"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]B", "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"1", "-", 
     FractionBox["Scap", 
      RowBox[{"2", "\[Pi]", "*", 
       SuperscriptBox["Rdome", "2"]}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "Kb", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Kb", "/", "\[Gamma]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lc", "=", 
   RowBox[{"Sqrt", "[", "Scap", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]B", "=", 
   RowBox[{"\[Lambda]", "/", "Lc"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RdomeB", "=", 
   RowBox[{"Rdome", "/", "Lc"}]}], ";"}]}], "Input",
