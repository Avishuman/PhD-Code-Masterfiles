    RowBox[{"-", "58.13857966389962"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", "Rdome"}], "=", 
     RowBox[{"15", "nm"}]}], ",", " ", 
    RowBox[{"\[Gamma]", "=", "0.0001"}], ",", " ", 
    RowBox[{"Lc", "=", "\[Lambda]"}], ",", " ", 
    RowBox[{"sb", " ", "=", " ", 
