            RowBox[{"shoot", "[", 
             RowBox[{"prfBi", ",", "p\[Psi]fBi", ",", "h0Bi", ",", "fVal"}], 
             "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"prfBi", ",", "prfBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"h0Bi", ",", "h0Bs"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Newton\>\"", ",", 
              RowBox[{"\"\<StepControl\>\"", "->", "\"\<LineSearch\>\""}]}], 
             "}"}]}], ",", 
           RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"p\[Psi]fBs", "=", 
         RowBox[{"p\[Psi]fBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prfBs", "=", 
         RowBox[{"prfBi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"h0Bs", "=", 
         RowBox[{"h0Bi", "/.", "sols"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"dummy", "=", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"shoot", "[", 
           RowBox[{"prfBs", ",", "p\[Psi]fBs", ",", "h0Bs", ",", "fVal"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Gamma]=\>\"", ",", "\[Gamma]", 
          ",", "\"\< \[Beta]=\>\"", ",", 
          RowBox[{"dummy", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< prfB[sbB]=\>\"", ",", 
          RowBox[{"dummy", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "\"\< h0B[sbB]=\>\"", ",", 
          RowBox[{"dummy", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Re", "-", 
          RowBox[{
          "run", " ", "NDSolve", " ", "with", " ", "the", " ", "converged", " ",
            "roots", " ", "to", " ", "extract", " ", "the", " ", "full", " ", 
           "profile"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ndsol", "=", 
         RowBox[{"SolveShapeEqs", "[", 
          RowBox[{"prfBs", ",", "p\[Psi]fBs", ",", "h0Bs", ",", "fVal"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Psi]ff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"\[Psi]fB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"rfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"hff", "[", "s_", "]"}], "=", 
         RowBox[{"First", "[", 
          RowBox[{
           RowBox[{"hfB", "[", "s", "]"}], "/.", "ndsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Energy", " ", "Integrand"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"en", "=", 
         RowBox[{"Kb", " ", "\[Pi]", " ", 
          RowBox[{"rff", "[", "s", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], ",", "s"}], "]"}], "+", 
               FractionBox[
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}], 
                RowBox[{"rff", "[", "s", "]"}]]}], ")"}], "2"], "+", 
            RowBox[{
             FractionBox["2", 
              SuperscriptBox["\[Lambda]B", "2"]], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]ff", "[", "s", "]"}], "]"}]}], ")"}]}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Gfootprint", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{"en", ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "s0B", ",", "sbB"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Gtether", "=", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], " ", "Kb", " ", "fVal", " ", "h0Bs"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"G", "=", 
         RowBox[{"Gfootprint", "+", "Gtether"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", "G"}], "}"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
