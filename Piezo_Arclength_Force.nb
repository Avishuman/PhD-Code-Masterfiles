           RowBox[{"{", 
            RowBox[{"p\[Psi]fBi", ",", "p\[Psi]fBs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"h0fBi", ",", "h0fBs"}], "}"}], ",", 
           RowBox[{"Method", "->", 
